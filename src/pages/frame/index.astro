---
import Layout from '../../layouts/Layout.astro';
import PhotoBorder from '../../components/tools/PhotoBorder.svelte';
---

<Layout
	title="Frame"
	description="Frame photos with even borders, square canvases, or a matching ratio for a mixed photo stack."
	noIndex={true}
>
	<div class="frame-page">
		<h1 data-motion="text">Frame</h1>
		<p class="lede" data-motion="text">
			A little room around your photos. Add borders, make them square, or fit a mixed stack to one canvas.
		</p>
		<div data-motion="media">
			<PhotoBorder client:load />
		</div>
	</div>
</Layout>

<style>
	.frame-page {
		max-width: 680px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	h1 {
		margin: 0 0 0.4rem;
		color: #333;
		font-size: 1.35rem;
		font-weight: 500;
		letter-spacing: 0.04em;
	}

	.lede {
		margin: 0 0 2rem;
		color: #777;
		font-size: 0.9rem;
		line-height: 1.5;
	}
</style>
