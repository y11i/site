---
import Frost from '../../components/Frost.astro';
import Nav from '../../components/Nav.astro';
import Layout from '../../layouts/Layout.astro';
import NowEntry from '../../components/now/NowEntry.astro';
import ArchiveList from '../../components/now/ArchiveList.astro';
import { loadNowEntries, type NowEntry as NowEntryType } from '../../utils/loadNowEntries';

// Import all images from the now folder
const imageModules = import.meta.glob('../../assets/images/now/*.{jpg,jpeg,png,gif,webp}', {
	eager: true,
	import: 'default',
}) as Record<string, any>;

// Helper to resolve image paths
function resolveImagePath(imagePath: string) {
	if (imagePath.startsWith('../images/now/')) {
		const filename = imagePath.replace('../images/now/', '');
		// Try to find the image in the glob results
		for (const [key, value] of Object.entries(imageModules)) {
			if (key.endsWith(filename)) {
				return typeof value === 'string' ? value : (value?.src || value?.default?.src || value);
			}
		}
	}
	return imagePath;
}

// Load all entries
const sortedEntries = loadNowEntries();

// Resolve image paths for the latest entry
const latestEntry = sortedEntries[0] ? {
	...sortedEntries[0],
	images: sortedEntries[0].images?.map(resolveImagePath) || []
} : null;

// Get archive entries (all except latest)
const archiveEntries = sortedEntries.slice(1);

// Get current page from query params
const currentPage = Number(Astro.url.searchParams.get('page') || '1');
---

<Layout>
	<Frost />
	<Nav currentPage="now" />
	<div class="now-page">
		{latestEntry && (
			<NowEntry
				title={latestEntry.title}
				date={latestEntry.date}
				location={latestEntry.location}
				content={latestEntry.content}
				images={latestEntry.images || []}
			/>
		)}

		{archiveEntries.length > 0 && (
			<ArchiveList entries={archiveEntries} currentPage={currentPage} />
		)}
	</div>
</Layout>

<style>
	.now-page {
		font-family: 'SUSE Mono', monospace;
		min-height: 80vh;
	}

	:global(.now-page *) {
		font-family: 'SUSE Mono', monospace;
	}
</style>
