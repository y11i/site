---
import Frost from '../../components/Frost.astro';
import Nav from '../../components/Nav.astro';
import Layout from '../../layouts/Layout.astro';
import NowEntry from '../../components/now/NowEntry.astro';
import ArchiveList from '../../components/now/ArchiveList.astro';
import { loadNowEntries, type NowEntry as NowEntryType } from '../../utils/loadNowEntries';

// Import all images from the now folder and subdirectories
const imageModules = import.meta.glob('../../assets/images/now/**/*.{jpg,jpeg,png,gif,webp,JPG,JPEG,PNG,GIF,WEBP}', {
	eager: true,
	import: 'default',
}) as Record<string, any>;

// Helper to get images for a specific slug
function getImagesForSlug(slug: string): any[] {
	const images: any[] = [];
	const slugDir = `/now/${slug}/`.toLowerCase();
	
	for (const [key, value] of Object.entries(imageModules)) {
		// Check if the image path includes the slug directory (case-insensitive)
		if (key.toLowerCase().includes(slugDir)) {
			const imageData = typeof value === 'string' ? value : (value?.src || value?.default?.src || value);
			images.push(imageData);
		}
	}
	
	// Sort by filename for consistent ordering
	return images.sort((a, b) => {
		const aPath = typeof a === 'string' ? a : a.src;
		const bPath = typeof b === 'string' ? b : b.src;
		return aPath.localeCompare(bPath);
	});
}

// Load all entries
const sortedEntries = loadNowEntries();

// Get images for the latest entry
const latestEntry = sortedEntries[0] ? {
	...sortedEntries[0],
	images: getImagesForSlug(sortedEntries[0].slug)
} : null;

// Get archive entries (all except latest)
const archiveEntries = sortedEntries.slice(1);

// Get current page from query params
const currentPage = Number(Astro.url.searchParams.get('page') || '1');
---

<Layout
	title="Now"
	description="Current updates from Sean Choi, plus the archive of past notes."
>
	<Frost />
	<Nav currentPage="now" />
	<div class="now-page">
		{latestEntry && (
			<NowEntry
				title={latestEntry.title}
				date={latestEntry.date}
				location={latestEntry.location}
				content={latestEntry.content}
				images={latestEntry.images || []}
			/>
		)}

		{archiveEntries.length > 0 && (
			<ArchiveList entries={archiveEntries} currentPage={currentPage} />
		)}
	</div>
</Layout>

<style>
	.now-page {
		font-family: 'SUSE Mono', monospace;
		min-height: 80vh;
	}

	:global(.now-page *) {
		font-family: 'SUSE Mono', monospace;
	}
</style>
