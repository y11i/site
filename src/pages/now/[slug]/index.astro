---
import Nav from '../../../components/Nav.astro';
import Layout from '../../../layouts/Layout.astro';
import NowEntry from '../../../components/now/NowEntry.astro';
import { loadNowEntries, type NowEntry as NowEntryType } from '../../../utils/loadNowEntries';

export async function getStaticPaths() {
	// Import all images from the now folder and subdirectories
	const imageModules = import.meta.glob('../../../assets/images/now/**/*.{jpg,jpeg,png,gif,webp,JPG,JPEG,PNG,GIF,WEBP}', {
		eager: true,
		import: 'default',
	}) as Record<string, any>;

	// Helper to get images for a specific slug
	function getImagesForSlug(slug: string): any[] {
		const images: any[] = [];
		const slugDir = `/now/${slug}/`.toLowerCase();
		
		for (const [key, value] of Object.entries(imageModules)) {
			// Check if the image path includes the slug directory (case-insensitive)
			if (key.toLowerCase().includes(slugDir)) {
				const imageData = typeof value === 'string' ? value : (value?.default || value);
				images.push(imageData);
			}
		}
		
		// Sort by filename for consistent ordering
		return images.sort((a, b) => {
			const aPath = typeof a === 'string' ? a : a.src;
			const bPath = typeof b === 'string' ? b : b.src;
			return aPath.localeCompare(bPath);
		});
	}

	// Load all entries
	const entries = loadNowEntries();

	// Return paths for each entry with automatically loaded images
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: {
			entry: {
				...entry,
				images: getImagesForSlug(entry.slug)
			}
		},
	}));
}

interface Props {
	entry: NowEntryType;
}

const { entry } = Astro.props;

function buildDescription(content: string): string {
	const plainText = content
		.replace(/[#>*_`~\[\]\(\)!]/g, '')
		.replace(/\s+/g, ' ')
		.trim();
	return plainText.length > 155 ? `${plainText.slice(0, 155).trim()}...` : plainText;
}

const description = buildDescription(entry.content);
---

<Layout
	title={`Now: ${entry.title}`}
	description={description}
>
	<Nav currentPage="now" />
	<div class="now-page">
		<div class="back-link" data-motion="text" data-motion-repeat="false">
			<a href="/now">← Back</a>
		</div>
		<NowEntry
			title={entry.title}
			date={entry.date}
			location={entry.location}
			content={entry.content}
			images={entry.images || []}
			showDecorativeLines={false}
		/>
	</div>
</Layout>

<style>
	.now-page {
		font-family: 'SUSE Mono', monospace;
	}

	.back-link {
		max-width: 500px;
		margin: 2rem auto 0;
		padding: 0 2rem;
	}

	.back-link a {
		color: #666;
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s ease;
	}

	.back-link a:hover {
		color: #333;
	}

	:global(.now-page *) {
		font-family: 'SUSE Mono', monospace;
	}

	@media (max-width: 640px) {
		.back-link {
			margin-top: 1rem;
		}
	}
</style>
