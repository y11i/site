---
import Nav from '../../components/Nav.astro';
import Layout from '../../layouts/Layout.astro';
import PhotosGallery from '../../components/gallery/PhotosGallery.svelte';
import photosMetadata from '../../assets/content/gallery/photos.json';

// Import all images from the photos directory
const allImageModules = import.meta.glob('../../assets/images/photos/**/*.{jpg,jpeg,png,gif,webp}', {
	eager: true,
	import: 'default',
}) as Record<string, any>;

type PhotoMetadata = {
	fileName: string;
	caption: string;
};

const imageModulesByFileName = new Map<string, any>();
const images: any[] = [];

// Helper to extract filename from import path
function extractFileName(path: string): string {
	const parts = path.split('/');
	const filename = parts[parts.length - 1];
	return filename;
}

for (const [path, image] of Object.entries(allImageModules)) {
	// Preserve the full image object (ImageMetadata) if available, otherwise use the src string
	const imageData = typeof image === 'string' ? image : (image || image?.default);
	
	// Extract filename from the import path and attach it to the image data
	const fileName = extractFileName(path);
	imageModulesByFileName.set(fileName, imageData);
}

for (const photo of photosMetadata as PhotoMetadata[]) {
	const imageData = imageModulesByFileName.get(photo.fileName);
	if (!imageData) continue;

	const imageWithMetadata = typeof imageData === 'object' && imageData !== null
		? { ...imageData, __filename: photo.fileName, caption: photo.caption }
		: { src: imageData, __filename: photo.fileName, caption: photo.caption };

	images.push(imageWithMetadata);
}
---

<Layout
	title="Photos"
	description="Photography by Sean Choi."
>
	<Nav currentPage="photos" />
	<div class="photos-page">
		<PhotosGallery client:idle images={images} />
	</div>
</Layout>

<style>
	.photos-page {
		font-family: 'SUSE Mono', monospace;
	}

	:global(.photos-page *) {
		font-family: 'SUSE Mono', monospace;
	}
</style>
