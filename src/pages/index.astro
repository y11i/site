---
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
---

<Layout
	title="Sean Choi"
	description="Personal site of Sean Choi, featuring work, photography, and current updates."
>
	<Nav currentPage="home" />
	<div class="content-area">
		<About />
	</div>
</Layout>

<style>
	.content-area {
		position: relative;
		width: 100%;
	}

	:global(.about) {
		position: relative;
		z-index: 2;
	}

</style>
