---
interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;

const pages = [
  { path: '/', label: 'home', slug: 'home' },
  { path: '/now', label: 'now', slug: 'now' },
  { path: '/photos', label: 'photos', slug: 'photos' }
];

function isActive(slug: string): boolean {
  return slug === currentPage;
}
---

<header class="nav-container">
  <h1 class="page-title">
    <a href="/">Y.S. Choi</a>
  </h1>
  <nav class="nav-links" aria-label="Site">
    {pages.map((page, index) => (
      <>
        <a
          href={page.path}
          class:list={{ active: isActive(page.slug) }}
          aria-current={isActive(page.slug) ? 'page' : undefined}
        >
          {page.label}
        </a>
        {index < pages.length - 1 && <span class="separator">•</span>}
      </>
    ))}
  </nav>
</header>

<style>
  .nav-container {
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.75rem;
    max-width: 500px;
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    padding: 6rem 2rem 2rem;
  }

  .page-title {
    flex: 0 0 auto;
    font-size: clamp(2rem, 4vw, 2.25rem);
    font-weight: 400;
    margin: 0;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }

  .page-title a {
    color: inherit;
    text-decoration: none;
  }

  .nav-links {
    flex: 0 0 auto;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 400;
  }

  .nav-links a {
    color: #999;
    text-decoration: none;
    transition: color 0.2s ease;
    padding: 0.25rem 0;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: #666;
  }

  .nav-links a.active {
    color: #333;
    font-weight: 600;
  }

  .separator {
    color: #ccc;
    margin: 0 0.25rem;
    user-select: none;
  }

  @media (max-width: 640px) {
    .nav-container {
      flex-direction: column;
      align-items: flex-start;
      padding: 5rem 2rem 1.75rem;
    }

    .page-title {
      font-size: 2rem;
    }

    .nav-links {
      width: 100%;
      margin-left: 0;
      justify-content: flex-start;
    }
  }
</style>
