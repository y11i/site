---
import ImageCarousel from "./ImageCarousel.svelte";
import type { ImageMetadata } from "astro";
import { parseInlineMarkdown } from "../../utils/markdown";

interface Props {
  title: string;
  date: string;
  location?: string;
  content: string;
  images?: (string | ImageMetadata)[];
  showDecorativeLines?: boolean;
}

const { title, date, location, content, images = [], showDecorativeLines = true } = Astro.props;

// Split content into paragraphs
const paragraphs = content
  .split("\n\n")
  .filter((p) => p.trim().length > 0)
  .map((p) => parseInlineMarkdown(p.trim()));
---

<article class={`now-entry ${showDecorativeLines ? 'with-lines' : ''}`}>
  <h1 class="entry-title" data-motion="text" data-motion-repeat="false">{title}</h1>
  <div class="entry-meta" data-motion="text" data-motion-repeat="false" style="--motion-delay: 80ms;">
    <span class="entry-date">{date}</span>
    {location && <span class="entry-location">{location}</span>}
  </div>

  <div class="entry-content">
    {
      paragraphs.map((paragraph, index) => (
        <p
          class="entry-text"
          data-motion="text"
          data-motion-repeat="false"
          style={`--motion-delay: ${140 + index * 90}ms;`}
          set:html={paragraph}
        />
      ))
    }
  </div>

  {images && images.length > 0 && (
    <div class="entry-carousel" data-motion="media" data-motion-repeat="false" style="--motion-delay: 180ms;">
      <ImageCarousel client:visible images={images} />
    </div>
  )}
</article>

<style>
  .now-entry {
    box-sizing: border-box;
    width: 100%;
    max-width: 500px;
    margin-inline: auto;
    padding: 2rem;
    min-width: 0;
    position: relative;
  }

  .now-entry.with-lines::before {
    content: "";
    position: absolute;
    top: 10px;
    left: 10px;
    width: 50px;
    height: 1px;
    background: #ddd;
  }

  .now-entry.with-lines::after {
    content: "";
    position: absolute;
    top: 10px;
    left: 10px;
    width: 1px;
    height: 50px;
    background: #ddd;
  }

  .entry-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: #333;
    line-height: 1.2;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: #666;
  }

  .entry-date {
    text-align: left;
  }

  .entry-location {
    text-align: right;
  }

  .entry-content {
    margin-bottom: 2rem;
  }

  .entry-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
    margin: 0 0 1.5rem 0;
  }

  @media (max-width: 640px) {
    .entry-text {
      font-size: 0.95rem;
    }
  }

  .entry-text :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .entry-text :global(a:visited) {
    color: inherit;
  }

  .entry-text:last-child {
    margin-bottom: 0;
  }

  .entry-carousel {
    margin-top: 0.5rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }
</style>
