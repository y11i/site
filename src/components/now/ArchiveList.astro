---
interface ArchiveEntry {
	title: string;
	date: string;
	location?: string;
	slug: string;
}

interface Props {
	entries: ArchiveEntry[];
	currentPage?: number;
	itemsPerPage?: number;
}

const { entries, currentPage = 1, itemsPerPage = 3 } = Astro.props;

const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const paginatedEntries = entries.slice(startIndex, endIndex);
const totalPages = Math.ceil(entries.length / itemsPerPage);

// Format date for display
function formatDate(dateString: string): string {
	return dateString;
}
---

<section class="archive-section">
	<h2 class="archive-title">Archive</h2>

	<div class="archive-entries">
		{paginatedEntries.map((entry) => (
			<a href={`/now/${entry.slug}`} class="archive-entry">
				<div class="archive-entry-content">
					<h3 class="archive-entry-title">{entry.title}</h3>
					<div class="archive-entry-meta">
						<span class="archive-entry-date">{formatDate(entry.date)}</span>
						{entry.location && (
							<span class="archive-entry-location">{entry.location}</span>
						)}
					</div>
				</div>
			</a>
		))}
	</div>

	{totalPages > 1 && (
		<div class="archive-pagination">
			{Array.from({ length: totalPages }, (_, i) => (
				<button
					class={`pagination-dot ${i + 1 === currentPage ? 'active' : ''}`}
					aria-label={`Go to page ${i + 1}`}
					data-page={i + 1}
				></button>
			))}
		</div>
	)}
</section>

<style>
	.archive-section {
		max-width: 550px;
		margin: 0 auto;
		padding: 2rem 2rem;
		font-family: 'SUSE Mono', monospace;
		position: relative;
	}

	.archive-section::before {
		content: '';
		position: absolute;
		top: 10px;
		right: 10px;
		width: 50px;
		height: 1px;
		background: #ddd;
	}

	.archive-section::after {
		content: '';
		position: absolute;
		top: -30px;
		right: 10px;
		width: 1px;
		height: 125px;
		background: #ddd;
	}

	.archive-title {
		font-size: 1rem;
    font-weight: 600;
		margin: 0 0 2rem 0;
		color: #333;
	}

	.archive-entries {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.archive-entry {
		display: block;
		text-decoration: none;
		color: inherit;
		background: rgba(0, 0, 0, 0.02);
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: 4px;
		padding: 1.5rem;
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.archive-entry:hover {
		background: rgba(0, 0, 0, 0.04);
		border-color: rgba(0, 0, 0, 0.1);
	}

	.archive-entry-content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.archive-entry-title {
    font-size: 14px;
		font-weight: 400;
		margin: 0;
		color: #333;
		line-height: 1.4;
	}

	.archive-entry-meta {
		display: flex;
		gap: 1rem;
		font-size: 0.85rem;
		color: #666;
	}

	.archive-entry-date,
	.archive-entry-location {
		font-family: 'SUSE Mono', monospace;
	}

	.archive-pagination {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 3rem;
	}

	.pagination-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #ccc;
		border: none;
		cursor: pointer;
		padding: 0;
		transition: background 0.2s ease;
	}

	.pagination-dot:hover {
		background: #999;
	}

	.pagination-dot.active {
		background: #666;
	}

	@media (max-width: 640px) {
		.archive-section {
			padding: 2rem;
			margin-top: 2rem;
		}

		.archive-title {
			font-size: 1.5rem;
		}

		.archive-entry {
			padding: 1rem;
		}

		.archive-entry-title {
			font-size: 0.95rem;
		}
	}
</style>

<script>
	// Handle pagination clicks
	document.addEventListener('DOMContentLoaded', () => {
		const paginationDots = document.querySelectorAll('.pagination-dot');
		paginationDots.forEach((dot) => {
			dot.addEventListener('click', (e) => {
				const page = (e.target as HTMLElement).dataset.page;
				if (page) {
					const url = new URL(window.location.href);
					url.searchParams.set('page', page);
					window.location.href = url.toString();
				}
			});
		});
	});
</script>

