---
import aboutContent from "../assets/content/about.md?raw";
import { parseInlineMarkdown } from "../utils/markdown";

const aboutLines = aboutContent.split("\n");
let emailLineRaw = "";

for (let i = aboutLines.length - 1; i >= 0; i -= 1) {
  const line = aboutLines[i].trim();

  if (!line) continue;
  if (line.includes("@") || /\(at\)/i.test(line)) {
    emailLineRaw = line;
    aboutLines.splice(i, 1);
    break;
  }
}

// Split remaining about content into paragraphs
const paragraphs = aboutLines
  .join("\n")
  .split("\n\n")
  .filter((p) => p.trim().length > 0)
  .map((p) => parseInlineMarkdown(p.trim()));

const contentParagraphs = paragraphs;
const emailParagraph = parseInlineMarkdown(emailLineRaw);
---

<section class="about">
  <div class="about-box">
    {contentParagraphs.map((paragraph, index) => (
      <p
        class="about-text"
        data-motion="text"
          data-motion-repeat="false"
          style={`--motion-delay: ${index * 130}ms; --motion-enter-duration: 750ms; --motion-enter-duration-fast: 550ms;`}
        set:html={paragraph}
      />
    ))}
    {emailParagraph && (
      <div class="contact-row">
        <p
          class="about-text"
          data-motion="text"
          data-motion-repeat="false"
          style={`--motion-delay: ${contentParagraphs.length * 130}ms; --motion-enter-duration: 750ms; --motion-enter-duration-fast: 550ms;`}
          set:html={emailParagraph}
        />
        <div
          class="social-links"
          data-motion="text"
          data-motion-repeat="false"
          style={`--motion-delay: ${(contentParagraphs.length + 1) * 130}ms; --motion-enter-duration: 750ms; --motion-enter-duration-fast: 550ms;`}
        >
          <a href="https://www.linkedin.com/in/szean" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@szeanchoi" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/szeanchoi" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="https://x.com/yscdev" target="_blank" rel="noopener noreferrer" aria-label="X" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.54L6.34 22H3.2l7.24-8.27L.8 2h6.39l4.42 5.91L18.9 2zm-1.09 18h1.72L6.26 3.9H4.42L17.81 20z"/>
            </svg>
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .about {
    max-width: 500px;
    margin: 0 auto;
    padding: 2rem;
  }

  .about-box {
    padding: 0;
    border-radius: 5px;
    background: transparent;
    text-align: left;
    box-shadow: none;
  }

  .about-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
    margin: 0 0 1rem 0;
  }

  .about-text :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .about-text :global(a:visited) {
    color: inherit;
  }

  .about-text:last-child {
    margin-bottom: 0;
  }

  .contact-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .contact-row .about-text {
    margin: 0;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #333;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .social-link:hover {
    color: #666;
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 640px) {
    .about {
      padding: 2rem;
    }

    .about-text {
      font-size: 0.95rem;
    }

    .social-links {
      gap: 0.5rem;
    }

    .contact-row {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }

    .social-link svg {
      width: 18px;
      height: 18px;
    }
  }
</style>
