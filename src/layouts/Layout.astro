---
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const baseTitle = 'YSC';
const fullTitle = title ? `${title} - ${baseTitle}` : `${baseTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=SUSE+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <main class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    font-family: 'Bodoni Moda', 'Times New Roman', serif;
    margin: 0;
    width: 100%;
    min-height: 100%;
    color: #333;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-image: 
      radial-gradient(circle at 1px 1px, rgba(0, 0, 0, .05) 1.5px, transparent 0);
    background-size: 25px 25px;
  }

  .main-content {
    flex: 1;
  }


  .suse-mono-<uniquifier > {
    font-family: "SUSE Mono", sans-serif;
    font-optical-sizing: auto;
    font-weight: <weight>;
    font-style: normal;
  }

  .bodoni-moda-<uniquifier > {
    font-family: "Bodoni Moda", serif;
    font-optical-sizing: auto;
    font-weight: <weight>;
    font-style: normal;
  }

  :global(*::selection) {
    background: #ccc;
    color: #fff;
  }
  
  :global(*::-moz-selection) {
    background: #ccc;
    color: #fff;
  }

  /* Custom scrollbar - glassy and skinny */
  :global(::-webkit-scrollbar) {
    width: 6px;
    height: 6px;
  }

  :global(::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(::-webkit-scrollbar-thumb) {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 10px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background 0.2s ease;
  }

  /* Firefox scrollbar */
  :global(html) {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.2) transparent;
  }
</style>
